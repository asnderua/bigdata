    <DTS:Executable
      DTS:refId="Package\Tarea Ejecutar SQL"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{E6683F45-DEDF-4BD9-A7C2-DADF36C7ED0A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Tarea Ejecutar SQL"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C10BB84F-4BDA-4E34-8A69-43475F54D341}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="USE DW_LigasAscenso;&#xA;GO&#xA;&#xA;-- 1. Vaciar primero la tabla de hechos (dependiente)&#xA;DELETE FROM dbo.Fact_VentasTaquilla;&#xA;&#xA;-- 2. Vaciar las dimensiones (padres)&#xA;DELETE FROM dbo.Dim_Tiempo;&#xA;DELETE FROM dbo.Dim_Partido;&#xA;DELETE FROM dbo.Dim_Estadio;&#xA;DELETE FROM dbo.Dim_TipoEntrada;&#xA;DELETE FROM dbo.Dim_Ubicacion;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Tarea Ejecutar SQL 1"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{8A46FDD2-D897-449A-A5AC-90818E228314}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Tarea Ejecutar SQL 1"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{9A864419-A9F0-4588-A46F-DC05F15414DC}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="USE DW_LigasAscenso;&#xA;GO&#xA;&#xA;TRUNCATE TABLE dbo.Fact_VentasTaquilla;&#xA;GO&#xA;&#xA;INSERT INTO dbo.Fact_VentasTaquilla (&#xA;    ID_Tiempo, &#xA;    ID_Partido, &#xA;    ID_Estadio, &#xA;    ID_TipoEntrada, &#xA;    ID_Ubicacion, &#xA;    CantidadBoletosVendidos, &#xA;    MontoIngresoTotal,&#xA;    PrecioPromedioBoletos&#xA;)&#xA;SELECT &#xA;    t.ID_Tiempo,&#xA;    p.ID_Partido,&#xA;    e.ID_Estadio,&#xA;    te.ID_TipoEntrada,&#xA;    u.ID_Ubicacion,&#xA;    s.CantidadBoletosVendidos,&#xA;    s.MontoIngresoTotal,&#xA;    s.PrecioPromedioBoletos&#xA;FROM dbo.stg_ligas_ascenso s&#xA;INNER JOIN dbo.Dim_Tiempo t ON s.Fecha = t.Fecha&#xA;INNER JOIN dbo.Dim_Partido p ON s.ID_PartidoOrigen = p.ID_PartidoOrigen&#xA;INNER JOIN dbo.Dim_Estadio e ON s.NombreEstadio = e.NombreEstadio&#xA;INNER JOIN dbo.Dim_TipoEntrada te ON s.NombreZona = te.NombreZona &#xA;                               AND s.CanalVenta = te.CanalVenta &#xA;                               AND s.MetodoPago = te.MetodoPago&#xA;INNER JOIN dbo.Dim_Ubicacion u ON s.Departamento = u.Departamento &#xA;                               AND s.Provincia = u.Provincia &#xA;                               AND s.Distrito = u.Distrito;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
