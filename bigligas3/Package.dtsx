                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT 
    CONVERT(INT, CONVERT(VARCHAR(8), CAST(Fecha AS DATE), 112)) AS ID_Tiempo,
    CAST(Fecha AS DATE) AS Fecha,
    YEAR(CAST(Fecha AS DATE)) AS Anio,
    MONTH(CAST(Fecha AS DATE)) AS Mes,
    CAST(DATENAME(month, CAST(Fecha AS DATE)) AS VARCHAR(20)) AS NombreMes,
    DAY(CAST(Fecha AS DATE)) AS Dia,
    CAST(DATENAME(weekday, CAST(Fecha AS DATE)) AS VARCHAR(20)) AS DiaSemana,
    0 AS Hora,
    CAST('No especificado' AS VARCHAR(20)) AS RangoHorario
FROM dbo.stg_ligas_ascenso
WHERE Fecha IS NOT NULL;</property>
