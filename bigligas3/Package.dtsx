            <component
              refId="Package\staging capa\Origen de OLE DB"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
              description="Origen de OLE DB"
              name="Origen de OLE DB"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    CAST(b.FechaVenta AS DATE) AS Fecha,
    p.IDpartido AS ID_PartidoOrigen,
    comp.NombreCompeticion,
    et.nombreEtapa AS NombreEtapa,
    comp.Nivelcompeticion AS NivelCompeticion,
    cl.NombreClub AS EquipoLocal,
    cv.NombreClub AS EquipoVisitante,
    p.EstadoPartido,
    est.NombreEstadio,
    est.Categoria AS CategoriaEstadio,
    est.MaxAforo,
    te.nombreTE AS NombreZona,
    b.CanalVenta,
    b.MetodoPago,
    u.Departamento,
    u.Provincia,
    u.Distrito,
    u.Region,
    COUNT(b.IDboleto) AS CantidadBoletosVendidos,
    SUM(b.PrecioPagado) AS MontoIngresoTotal,
    AVG(b.PrecioPagado) AS PrecioPromedioBoletos
FROM dbo.Boleto b
INNER JOIN dbo.Partido p ON b.IDpartido = p.IDpartido
INNER JOIN dbo.Etapas et ON p.IDetapa = et.IDetapa
INNER JOIN dbo.Competicion comp ON et.IDcompeticion = comp.IDcompeticion
INNER JOIN dbo.Estadio est ON p.IDestadio = est.IDestadio
INNER JOIN dbo.Ubicacion u ON est.IDubicacion = u.IDubicacion
INNER JOIN dbo.Club cl ON p.IDequipoLocal = cl.IDclub
INNER JOIN dbo.Club cv ON p.IDequipoVisitante = cv.IDclub
INNER JOIN dbo.TipoEntrada te ON b.IDtipoEntrada = te.IDtipoEntrada
WHERE b.EstadoPago = 'Pagado'
GROUP BY 
    CAST(b.FechaVenta AS DATE),
    p.IDpartido,
    comp.NombreCompeticion,
    et.nombreEtapa,
    comp.Nivelcompeticion,
    cl.NombreClub,
    cv.NombreClub,
    p.EstadoPartido,
    est.NombreEstadio,
    est.Categoria,
    est.MaxAforo,
    te.nombreTE,
    b.CanalVenta,
    b.MetodoPago,
    u.Departamento,
    u.Provincia,
    u.Distrito,
    u.Region;</property>
                <property
                  dataType="System.String"
                  description="Variable que contiene el comando SQL para ejecutar."
                  name="SqlCommandVariable"></property>
                <property
